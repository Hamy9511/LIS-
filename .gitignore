# Dependencias de Node.js instaladas al levantar los dockers
node_modules/
frontend/node_modules/
backend/node_modules/

# Variables de entorno y secretos
.env

# Archivos propios del IDE (ej. VS Code)
.vscode/
.idea/

# Compilados y builds de Angular o Node
dist/
out-tsc/
.angular/
build/

# Logs de error
npm-debug.log*
yarn-debug.log*
yarn-error.log*
backend/*.log
frontend/*.log

# Archivos de caché
.npm

# Archivos de la base de datos (Si llegarás a mapear la carpeta al proyecto en lugar de un volumen interno de Docker)
postgres_data/
*.sql

# Basura del Sistema Operativo
.DS_Store
Thumbs.db
